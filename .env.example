# Copy to .env and fill in. .env is git-ignored — never commit a real key.

# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Model used by every agent; default shown.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Where datasets and charts are written; default shown.
# `~` is expanded and a relative path is resolved against the working directory.
# ARTIFACT_DIR=~/.orchestra/artifacts

# Optional. The bundled mock dataset the agents read. Defaults to this repo's `data/`.
# DATA_DIR=./data
