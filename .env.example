# Copy to .env and fill in. .env is git-ignored — never commit a real key.

# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Model used by every agent; default shown.
# ANTHROPIC_MODEL=claude-opus-5

what Cap on one reply; default shown. The default model thinks by default and this
# caps thinking and output together, so a small value truncates the answer instead of
# shortening it.
# ANTHROPIC_MAX_TOKENS=16000

# Optional. Where datasets and charts are written; default shown. Each run writes into a
# timestamped subdirectory under it, so a run's files stay together and stay findable.
# `~` is expanded and a relative path is resolved against the working directory.
# ARTIFACT_DIR=~/.orchestra/artifacts

# Optional. The bundled mock dataset the agents read. Defaults to this repo's `data/`.
# DATA_DIR=./data

# Optional. Live web search for the Data Retrieval agent's `search` tool.
# Leave it unset and the agent searches the bundled offline corpus in `data/` instead —
# the run works either way, and the test suite never uses this key.
# Get one at https://app.tavily.com (free tier: 1,000 credits/month).
# TAVILY_API_KEY=tvly-...

# Optional. How many subtasks may run at once; default shown. Raising it costs provider
# rate limit, lowering it to 1 makes a run reproducible step by step.
# MAX_CONCURRENCY=4

# Optional. The bounds one subtask may spend before it fails; defaults shown. Both apply:
# turns catch an agent that keeps calling tools, tokens catch one calling expensive ones.
# WORKER_TOKEN_BUDGET=60000
# WORKER_MAX_TURNS=6

# Optional. How many times one subtask is attempted before it is marked failed; default
# shown. Every attempt spends the run's step budget, so raising it shortens the plan a run
# can finish. Attempts multiply rather than add: each one may spend WORKER_MAX_TURNS of
# model calls, and each of those its own structured-output retries.
# SUBTASK_ATTEMPTS=3
